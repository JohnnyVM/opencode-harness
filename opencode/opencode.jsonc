{
	"$schema": "https://opencode.ai/config.json",
	"default_agent": "spec-design",
	"lsp": true,
	"subagent_depth": 1,
	"mcp": {
		"playwright": {
			"type": "local",
			"command": [
				"podman",
				"run",
				"--rm",
				"-i",
				"--ipc=host",
				"mcp/playwright"
			],
			"enabled": true
		}
	}
}
