{
	"$schema": "https://opencode.ai/config.json",
	"default_agent": "build",
	"lsp": true,
	"subagent_depth": 2,
	"mcp": {
		"playwright": {
			"type": "local",
			"command": [
				"podman",
				"run",
				"--rm",
				"-i",
				"--ipc=host",
				"mcp/playwright"
			],
			"enabled": true,
			"timeout": 1800
		}
	}
}
